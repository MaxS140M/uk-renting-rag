# Secrets: real keys live only in .env, which must never be committed
.env

# Virtual environment
.venv/

# Python build and cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Derived data (rebuilt from data/raw/ by scripts/, not versioned).
# data/raw/ IS committed: it is the frozen corpus snapshot the evaluation set is written
# against, so quotes in eval/questions.jsonl can always be checked.
data/chunks*.jsonl
data/index*/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Unreviewed LLM question drafts (work in progress; reviewed items go to eval/questions.jsonl)
eval/drafts.jsonl
