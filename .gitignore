# Secrets: real keys live only in .env, which must never be committed
.env

# Virtual environment
.venv/

# Python build and cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Generated data and indexes (rebuilt by scripts/, not versioned).
