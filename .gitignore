# Secrets: real keys live only in .env, which must never be committed
.env

# Virtual environment
.venv/

# Python build and cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Derived data (rebuilt from data/raw/ by scripts/, not versioned).
# data/raw/ IS committed: it is the frozen corpus snapshot the evaluation set is written
# against, so quotes in eval/testset/questions.jsonl can always be checked.
data/chunks*.jsonl
data/index*/
data/llm_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Unreviewed LLM question drafts (work in progress; reviewed items go to eval/testset/questions.jsonl)
eval/testset/drafts.jsonl

# Per-question evaluation results (large; regenerate with scripts/evaluation/run_eval.py). The summary
# table and the held-out run log are committed.
eval/results/*.jsonl
!eval/results/heldout_runs.jsonl
